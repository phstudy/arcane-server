// InventoryItem.subData union members (client: Gamedata.EmoteSubData etc.; field order = accessor order).
table EmoteSubData {
    prefab:string;
    showInInventory:bool;
}

table ProfileFrameSubData {
    frameIcon:string;
    effectPrefab:string;
}

enum BoostRewardCategory:byte {
    None,
    Campaign,
    Tower,
    Events,
    Pvp,
    ClubDungeon,
    Raid,
    Expedition
}

table ResourceBoostSubData {
    boostItems:[ulong];
    boostAmount:float;
    gameMode:BoostRewardCategory;
}

table SorcererStoneSubData {
    offense:float;
    defense:float;
    health:float;
    recovery:float;
    critChance:float;
    critPower:float;
    attackSpeed:float;
    unitPowerValue:uint;
    unequipCost:ItemCount;
    requiredUnitLevel:uint;
    requiredUnitRarity:uint;
    requiredUnitGearTier:uint;
    speed:float;
    potency:float;
    tenacity:float;
    accuracy:float;
    evasion:float;
}

// Union type values match the client enum Gamedata.InventoryItemSubData (1..4).
union InventoryItemSubData {
    EmoteSubData,
    SorcererStoneSubData,
    ProfileFrameSubData,
    ResourceBoostSubData
}

